<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Starting..."
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#EEF3EE"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvScanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scanning nearby beacons..."
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgBeaconMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/rbMock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Simulated" />
                <RadioButton
                    android:id="@+id/rbReal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Real beacons" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/llBeacons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnAutoWalk"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Auto tour: off" />
                <Button
                    android:id="@+id/btnNext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Next artifact" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvArtifactTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No artifact nearby"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvArtifactMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:text="Ask Mira"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etQuestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="...or type a question"
                android:inputType="text" />
            <Button
                android:id="@+id/btnAsk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ask" />
        </LinearLayout>

        <Switch
            android:id="@+id/swWake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Always listen for Hey Mira" />

        <Button
            android:id="@+id/btnInterests"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My interests" />

        <TextView
            android:id="@+id/tvTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text=""
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
